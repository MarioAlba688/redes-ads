# Copia este archivo a .env y ajusta los valores.
#
# Conexion a MySQL: mysql://USUARIO:CLAVE@HOST:PUERTO/BASE_DE_DATOS
# Si la clave tiene simbolos (@ : / # % ?) hay que codificarlos: @ -> %40, # -> %23, / -> %2F ...
# Tip: node -e "console.log(encodeURIComponent('mi-clave#1'))"
#
# a) MySQL en tu PC (Laragon):
#    DATABASE_URL="mysql://root:@localhost:3306/redes"
# b) MySQL en un VPS (conexion cifrada con TLS):
#    ?sslaccept=strict                 valida el certificado del servidor (recomendado)
#    &sslcert=/ruta/al/ca.pem          CA con la que validar, si el certificado es propio
#    ?sslaccept=accept_invalid_certs   cifra pero NO valida el servidor (solo como parche temporal)
#    Sin ninguno de los dos, la clave y los datos viajan SIN cifrar por internet.
DATABASE_URL="mysql://usuario:clave@host:3306/redes"

# URL publica de la app (se usa para armar los links de invitacion).
# Si empieza con https://, la cookie de sesion se marca como segura.
APP_URL="http://localhost:3000"

# Clave para cifrar los tokens de las redes sociales en la base de datos.
# Debe ser de 32 bytes en base64. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANTE: si la pierdes o la cambias, habra que reconectar todas las cuentas.
ENCRYPTION_KEY=""

# Codigo para crear el primer administrador en /setup.
# Obligatorio en produccion; en desarrollo es opcional.
SETUP_TOKEN=""

# --- Meta (Facebook, Instagram, Meta Ads) ---
# Se obtienen en https://developers.facebook.com/apps > tu app > Configuracion > Basica.
# Pasos completos en el README ("Conectar Meta"). Sin estos dos valores, el boton "Conectar Meta" queda desactivado.
META_APP_ID=""
META_APP_SECRET=""
# Solo si tu app usa "Facebook Login for Business": ID de la configuracion (tipo de token: User access token).
META_LOGIN_CONFIG_ID=""
# Permisos a pedir (opcional, separados por comas). Si no se define se piden todos, incluidos los de publicacion
# e Instagram. Si tu app de Meta no los incluye, Facebook responde "Invalid Scopes": en ese caso usa solo los
# de anuncios y amplia la lista cuando agregues los casos de uso de paginas e Instagram en el panel de Meta.
# META_SCOPES="ads_read,pages_show_list,pages_read_engagement"
META_SCOPES=""
# Version de la Graph API. Vigente: v26.0 (cada version dura ~2 años).
META_GRAPH_VERSION="v26.0"

# --- Google Ads ---
# Se crean en Google Cloud Console (pasos en el README, "Conectar Google Ads"). Sin estos dos valores el boton
# "Conectar Google Ads" queda desactivado. La URI de redireccion autorizada es APP_URL + /api/google/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Version de la API de Google Ads. Vigente al escribir esto: v25 (la v26 salio el 2026-10-14; cada una dura ~1 año).
GOOGLE_ADS_API_VERSION="v25"
# Opcional: desde el 2026-09-09 Google ya no exige el "developer token" (el acceso lo da el proyecto de Google Cloud).
# Si lo pones se envia, pero Google lo ignora.
GOOGLE_ADS_DEVELOPER_TOKEN=""

# --- TikTok Ads (Marketing API) ---
# Se crean en https://business-api.tiktok.com/portal (pasos en el README, "Conectar TikTok Ads").
# La URL de retorno de la app es APP_URL + /api/tiktok/callback.
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""

# --- IA (Claude, GPT, Gemini) ---
# Las claves de los motores de IA (Claude, GPT de OpenAI, Gemini de Google) se ponen DESDE LA APP: entra como
# administrador a «Motores de IA». Alli se guardan cifradas en la base de datos, con el modelo de cada una, y el
# equipo elige el motor al crear una publicacion. No hace falta (ni conviene) ponerlas aqui.
# Solo para Claude hay un respaldo: si no hay clave de Claude guardada en la app, se usa esta. Sin ningun motor
# configurado el generador de textos queda desactivado (se puede seguir escribiendo y publicando a mano).
# Nunca pegues una clave en un chat ni la subas a un repositorio.
ANTHROPIC_API_KEY=""
# Modelo de Claude cuando se usa la clave de arriba. Por defecto claude-opus-5-5 (el mas capaz); para textos
# cortos tambien sirven claude-sonnet-5-5 o claude-haiku-5-5. (El modelo de cada motor guardado en la app se
# elige en «Motores de IA».)
AI_MODEL="claude-opus-5-5"
# Cuanto "piensa" Claude antes de responder: low (mas barato y rapido) | medium | high. (GPT y Gemini usan su valor normal.)
AI_EFFORT="medium"
# Generaciones por persona cada 24 horas, sumando todos los motores (cada una cuesta unos centavos).
AI_DAILY_LIMIT="40"

# --- Publicaciones ---
# Carpeta donde se guardan las imagenes de las publicaciones. En el VPS ponla FUERA de la carpeta del codigo y
# incluyela en las copias de seguridad. Si se deja vacia se usa ./storage/media.
MEDIA_DIR=""
# Direccion publica desde la que Meta descarga las imagenes para Instagram. Si se deja vacia se usa APP_URL, que
# para publicar en Instagram debe ser HTTPS y accesible desde internet (en localhost Instagram no puede descargar).
MEDIA_PUBLIC_BASE_URL=""
# Zona horaria con la que se muestran las fechas (creacion, historial, sincronizaciones). Las publicaciones
# programadas usan siempre la zona de su marca. Sin ella: America/Bogota.
APP_TIMEZONE="America/Bogota"

# --- Proceso en segundo plano (publica lo programado y sincroniza anuncios) ---
# Vive dentro del servidor de la app; necesita un servidor que se quede encendido (el VPS), no plataformas serverless.
# WORKER_ENABLED=false lo apaga (por ejemplo en una segunda copia de la app). Revisa cada 30 s por defecto.
WORKER_ENABLED="true"
WORKER_INTERVAL_SECONDS="30"
